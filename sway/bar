# man sway-bar

include ~/.config/sway/theme.conf

bar {
    position "top"

    font "JetBrains Mono 11"

    status_command ~/.config/sway/scripts/bar-status.sh

    colors {
        background $background
        statusline $statusline
        focused_workspace $fw_bord $fw_back $fw_text
        inactive_workspace $iw_bord $iw_back $iw_text
    }
}
